#!/bin/sh
# Refuses a commit that adds a binary file over 1 MiB (5 MiB for an image of a paper) or a file of
# dist/, which the CI builds and git does not keep (engine/sizes.py, which the CI runs too).
# Enabled by `make deps` (git config core.hooksPath .githooks).
exec python3 engine/sizes.py --staged
